{
  "version": "2.0.0",
  "presentation": {
    "reveal": "always",
    "panel": "dedicated"
  },
  "tasks": [
    {
      "type": "shell",
      "label": "CODAL build",
      "command": "python build.py",
      "windows": {
        "command": "py build.py"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "type": "shell",
      "label": "CODAL clean build",
      "command": "python build.py --clean",
      "windows": {
        "command": "py build.py --clean"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "type": "shell",
      "label": "IntelliSense: regenerate compile database",
      "detail": "Re-run the CMake configure step so build/compile_commands.json matches the current sources and flags.",
      "command": "cmake",
      "args": [
        "-S",
        ".",
        "-B",
        "build",
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
        "-DCMAKE_BUILD_TYPE=RelWithDebInfo"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
