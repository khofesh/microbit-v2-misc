{
  "configurations": [
    {
      "name": "micro:bit v2 (CODAL)",
      // Authoritative source of include paths, defines and flags for every
      // translation unit. Regenerated by the CODAL build.
      "compileCommands": "${workspaceFolder}/build/compile_commands.json",
      // Fallback used for headers that are not in the compile database.
      "includePath": [
        "${workspaceFolder}/source",
        "${workspaceFolder}/source/samples",
        "${workspaceFolder}/libraries",
        "${workspaceFolder}/libraries/codal-microbit-v2/inc",
        "${workspaceFolder}/libraries/codal-microbit-v2/inc/bluetooth",
        "${workspaceFolder}/libraries/codal-microbit-v2/inc/compat",
        "${workspaceFolder}/libraries/codal-microbit-v2/model",
        "${workspaceFolder}/libraries/codal-core/inc",
        "${workspaceFolder}/libraries/codal-core/inc/core",
        "${workspaceFolder}/libraries/codal-core/inc/driver-models",
        "${workspaceFolder}/libraries/codal-core/inc/drivers",
        "${workspaceFolder}/libraries/codal-core/inc/streams",
        "${workspaceFolder}/libraries/codal-core/inc/types",
        "${workspaceFolder}/libraries/codal-nrf52/inc",
        "${workspaceFolder}/libraries/codal-nrf52/inc/cmsis",
        "${workspaceFolder}/libraries/codal-nrf52/nrfx",
        "${workspaceFolder}/libraries/codal-nrf52/nrfx/mdk",
        "${workspaceFolder}/libraries/codal-nrf52/nrfx/hal",
        "${workspaceFolder}/libraries/codal-nrf52/nrfx/drivers/include",
        "${workspaceFolder}/libraries/codal-nrf52/nrfx/templates",
        "${workspaceFolder}/libraries/codal-microbit-nrf5sdk/sdk_config",
        "${workspaceFolder}/libraries/codal-microbit-nrf5sdk/nRF5SDK_mods",
        "${workspaceFolder}/libraries/codal-microbit-nrf5sdk/nRF5SDK/components/**",
        "${workspaceFolder}/libraries/codal-microbit-nrf5sdk/nRF5SDK/external/**",
        "${workspaceFolder}/build/libraries/codal-core/gen",
        "${workspaceFolder}/utils/cmake/toolchains/ARM_GCC"
      ],
      "defines": [
        "MICROBIT_EXPORTS",
        "NRF52833_XXAA",
        "NRF52833",
        "TARGET_MCU_NRF52833",
        "NRF5",
        "__CORTEX_M4",
        "S113",
        "TOOLCHAIN_GCC",
        "APP_TIMER_V2",
        "APP_TIMER_V2_RTC1_ENABLED",
        "NRF_DFU_TRANSPORT_BLE=1",
        "__START=target_start"
      ],
      "compilerPath": "/usr/bin/arm-none-eabi-g++",
      "compilerArgs": [
        "-mcpu=cortex-m4",
        "-mthumb",
        "-mfpu=fpv4-sp-d16",
        "-mfloat-abi=softfp"
      ],
      "cStandard": "c11",
      "cppStandard": "c++11",
      "intelliSenseMode": "linux-gcc-arm",
      "browse": {
        "path": [
          "${workspaceFolder}/source",
          "${workspaceFolder}/libraries",
          "${workspaceFolder}/build/libraries"
        ],
        "limitSymbolsToIncludedHeaders": true
      }
    }
  ],
  "version": 4
}
