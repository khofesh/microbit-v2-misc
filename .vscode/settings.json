{
  // The Microsoft C/C++ extension is disabled in the user settings on this
  // machine (the STM32 toolchain turns it off). Re-enable it here only.
  "C_Cpp.intelliSenseEngine": "default",
  "C_Cpp.errorSquiggles": "enabled",

  // IntelliSense is driven by the compile database generated by the CODAL
  // build (build.py / CMake). See the "IntelliSense: regenerate compile
  // database" task if it ever gets out of date.
  "C_Cpp.default.compileCommands": "${workspaceFolder}/build/compile_commands.json",
  "C_Cpp.default.compilerPath": "/usr/bin/arm-none-eabi-g++",
  "C_Cpp.default.intelliSenseMode": "linux-gcc-arm",
  "C_Cpp.default.cStandard": "c11",
  "C_Cpp.default.cppStandard": "c++11",

  // CODAL headers use .h but contain C++.
  "files.associations": {
    "*.h": "cpp"
  },
  "[cpp]": {
    "editor.defaultFormatter": "ms-vscode.cpptools"
  },

  // build.py owns the CMake configuration; don't let CMake Tools race it.
  "cmake.configureOnOpen": false,

  "search.exclude": {
    "**/build": true
  },
  "files.watcherExclude": {
    "**/build/**": true
  }
}
